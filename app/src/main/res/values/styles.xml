<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Shadow">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDy">1</item>
    </style>
    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/tile_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
    <style name="TileIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>
    <style name="TileValue" parent="Shadow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">--</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TileSub" parent="Shadow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
